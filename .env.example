# ---------- Database (Neon / Vercel Postgres / any Postgres) ----------
# Pooled connection string used at runtime
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------- Sarvam AI ----------
# https://dashboard.sarvam.ai -> API keys
SARVAM_API_KEY="sk_xxxxxxxxxxxxxxxxxxxx"
SARVAM_BASE_URL="https://api.sarvam.ai"
# Chat model used to rewrite English into easy Hinglish
SARVAM_CHAT_MODEL="sarvam-105b"
# TTS model + default voice (see README for the full speaker list)
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_SPEAKER="shubh"
SARVAM_TRANSLATE_MODEL="sarvam-translate:v1"

# ---------- Neon Object Storage (books bucket from neon.ts) ----------
# Pulled automatically by `neon link` / `neon env pull` after `neon deploy`.
AWS_REGION="us-east-2"
AWS_S3_BUCKET="books"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""

# ---------- Admin auth ----------
# Password you type at /admin/login
ADMIN_PASSWORD="change-me-please"
# Random 32+ char string used to sign the admin session cookie
# generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="replace-with-openssl-rand-hex-32"
